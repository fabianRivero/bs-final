# API keys used ONLY at build time by content/generate.py (never shipped in the game)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: model used by the build-time content pipeline.
# Defaults to gpt-4o-mini (OpenAI) or claude-sonnet-4-5 (Anthropic).
ALDERMERE_LLM_MODEL=
# Optional: local proxy for runtime AI diagnosis (see PLAN.md section 6)
ALDERMERE_LLM_PROXY=http://127.0.0.1:8765
