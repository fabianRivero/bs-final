; Engine configuration file for the Aldermere presentation layer.
;
; Godot presents and captures input. It never decides the rules: every piece of
; game data arrives through `res://data/game_content.json`, which is exported
; from the Python simulation core by `tools/export_web.py`.

config_version=5

[application]

config/name="Aldermere"
config/description="A top-down investigation RPG. Python decides, Godot presents."
config/version="0.3.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

GameState="*res://autoload/game_state.gd"
ContentDb="*res://autoload/content_db.gd"
Lighting="*res://autoload/lighting.gd"
SceneRouter="*res://autoload/scene_router.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="Aldermere"

[input]

